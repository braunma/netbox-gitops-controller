# Local Terraform state and working dirs (state lives in the GitLab backend)
.terraform/
*.tfstate
*.tfstate.*
crash.log

# Generated by cmd/tfgen — derived from inventory/virtual/<env>/*.yaml, not
# source. Covers the per-environment files (generated.prod.tfvars.json, …).
generated.tfvars.json
generated.*.tfvars.json

# NEVER commit real variable files — they hold secrets (API token, SSH keys).
# In CI everything is passed via TF_VAR_* and -var-file=generated.tfvars.json.
*.tfvars
*.auto.tfvars
*.auto.tfvars.json
.env
.env.*
