# PyCharm
.idea/

# VSCode
.vscode/

# Environment variables
.env
.env.local
.env.*.local

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Redis dumps (a local Redis dropping its snapshot into the working directory)
*.rdb

# Build/test caches
.cache/
# CI sets GOPATH to $CI_PROJECT_DIR/.go so the module cache survives between
# jobs; keep the downloaded dependencies out of git (and out of `git ls-files`,
# which is what `make lint` checks).
/.go/

# Go
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
/vendor/
/Godeps/
bin/
# Compiled binary at the repo root (anchored so it does not also ignore the
# cmd/netbox-gitops/ source directory)
/netbox-gitops

# Private data - exclude actual definitions and inventory from repository root
# (Tests use example/ directory instead)
/definitions/
/inventory/*
# ...except the VM definitions (one YAML per VM, per env under
# inventory/virtual/<env>/). They contain no secrets — credentials come from CI
# variables, not the YAML.
!/inventory/virtual/
# ...and except what fact ingestion writes. Discovered objects only become
# NetBox truth by being reviewed in a merge request, so they have to be
# committed; an ignored file would make every scan produce an empty diff.
!/inventory/discovered/

# Test coverage output (make test / CI)
coverage.out
__pycache__/
