# PyCharm
.idea/

# VSCode
.vscode/

# Environment variables
.env
.env.local
.env.*.local

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Build/test caches
.cache/
# CI sets GOPATH to $CI_PROJECT_DIR/.go so the module cache survives between
# jobs; keep the downloaded dependencies out of git (and out of `git ls-files`,
# which is what `make lint` checks).
/.go/

# Go
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
/vendor/
/Godeps/
bin/
# Compiled binary at the repo root (anchored so it does not also ignore the
# cmd/netbox-gitops/ source directory)
/netbox-gitops

# Private data - exclude actual definitions and inventory from repository root
# (Tests use example/ directory instead)
/definitions/
/inventory/*
# ...except the VM definitions: these drive BOTH NetBox documentation and
# Proxmox provisioning and are meant to be committed (one YAML per VM, per env
# under inventory/virtual/<env>/). They contain no secrets — credentials come
# from CI variables, not the YAML.
!/inventory/virtual/

# Test coverage output (make test / CI)
coverage.out
__pycache__/
