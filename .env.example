# Copy to .env and fill in. The controller reads this file at startup
# (override the path with --config); anything already exported in the
# environment wins over it, so a CI runner's variables are never shadowed by a
# file that happens to be checked out.
#
# .env itself is gitignored. Do not commit a token.

# Base URL of your NetBox, without a trailing /api.
NETBOX_URL=https://netbox.example.com

# API token. Both formats work: a v1 token is a 40-character hex string, a v2
# token (NetBox 4.5+) looks like nbt_<key>.<secret>. The controller picks the
# right Authorization header from the prefix.
NETBOX_TOKEN=0123456789abcdef0123456789abcdef01234567

# Optional: skip TLS certificate verification. Only for a lab NetBox behind a
# self-signed certificate — every run that sets it says so in its output.
# IGNORE_SSL_ERRORS=true

# Optional: a checkout of the community device type library, if you vendor one
# somewhere other than <data-dir>/definitions/device_type_library.
# DEVICETYPE_LIBRARY=../devicetype-library/device-types
# MODULETYPE_LIBRARY=../devicetype-library/module-types

# Optional: filename globs to park (skip while loading). Default: _*.yaml,_*.yml
# IGNORED_FILES=_*.yaml,_*.yml

# Optional: where `netbox-gitops collect` reads its source configuration.
# Default: <data-dir>/collectors.yaml (copy collectors.yaml.example).
# COLLECTORS_CONFIG=collectors.yaml

# Tokens for the systems `collect` scans go here too, named by the token_env of
# each source in collectors.yaml. They are read-only credentials for those
# systems — collect never contacts NetBox. Do not commit them.
# PROXMOX_TOKEN=root@pam!gitops=00000000-0000-0000-0000-000000000000
