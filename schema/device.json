                    "description": "The interface's address, e.g. 10.0.0.1/24.",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/definitions/InterfaceConfigEntry"
                  }
                ]
              },
              "description": "Interfaces keyed by name: an address alone, a mapping of fields, or nothing (listed for its defaults).",
              "type": "object"
