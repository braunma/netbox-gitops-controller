        },
        "parent_device": {
          "type": "string"
        },
        "position": {
          "type": "integer"
        },
        "rack": {
          "description": "Short for rack_slug.",
          "type": "string"
        },
        "rack_slug": {
          "type": "string"
        },
        "rear_ports": {
          "items": {
            "$ref": "#/definitions/RearPortConfig"
          },
          "type": "array"
        },
        "rename_from": {
          "description": "The object's previous name. Set it to correct a typo so the existing object is renamed instead of a second one being created; remove it once the sync has run.",
          "type": "string"
        },
        "role": {
          "description": "Short for role_slug.",
          "type": "string"
        },
        "role_slug": {
          "type": "string"
        },
        "serial": {
          "type": "string"
        },
        "site": {
          "description": "Short for site_slug.",
          "type": "string"
        },
        "site_slug": {
          "type": "string"
        },
        "status": {
          "enum": [
            "offline",
            "active",
            "planned",
            "staged",
            "failed",
            "inventory",
            "decommissioning"
