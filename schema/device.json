        },
        "custom_fields": {
          "description": "Values for NetBox custom fields, by field name. Only the fields named here are written.",
          "type": "object"
        },
        "device_bay": {
          "type": "string"
        },
        "device_type": {
          "description": "Short for device_type_slug.",
          "type": "string"
        },
        "device_type_slug": {
          "type": "string"
        },
        "face": {
          "description": "Rack face. Implied as front when a position is given and no face.",
          "enum": [
            "front",
            "rear"
          ],
          "type": "string"
        },
        "front_ports": {
          "items": {
            "$ref": "#/definitions/FrontPortConfig"
          },
          "type": "array"
