# Sources the `netbox-gitops collect` and `netbox-gitops scan` commands read.
#
# Copy this to collectors.yaml (or point --collectors-config somewhere else)
# and edit it. The file is safe to commit: it names the environment variable
# holding each source's token, never the token itself, so credentials stay in
# the CI variable store with NETBOX_TOKEN.
#
# Every collector is read-only against its source, and none of them can write
# to NetBox. A run's only effect is a change to the YAML in this repository,
# which reaches NetBox the same way every hand-written line does: through a
# merge request and a reconcile. See docs/INGEST.md.

sources:
  - name: pve-prod # identifies the source in logs and in inventory/discovered/<name>/
    type: proxmox
    url: https://pve.example.com:8006
    token_env: PROXMOX_TOKEN # holds "user@realm!tokenid=secret"; PVEAuditor on / is enough
    verify_tls: true # never turn this off against anything you care about
    cluster: berlin-prod-cluster # the NetBox cluster these guests belong to

  # A lab behind a self-signed certificate. verify_tls: false is per-source and
  # logs a warning on every run, so it cannot quietly spread to production.
  # - name: pve-lab
  #   type: proxmox
  #   url: https://lab.example.com:8006
  #   token_env: PVE_LAB_TOKEN
  #   verify_tls: false
  #   timeout_seconds: 60
  #   cluster: lab-cluster

  # ---------------------------------------------------------------------------
  # Scan sources (type: idrac), read by `netbox-gitops scan`.
  #
  # These are the one kind that writes to NetBox: the hardware facts a BMC
  # reports become hw_ custom fields on the device they were read from. There
  # is no host list. `targets: inventory` means the hosts are the addresses the
  # selected devices declare on `interface` in inventory/.
  #
  # One source per group of machines that shares credentials and network
  # reach. A device two sources select is an error, so `select` has to divide
  # the inventory cleanly; its keys are site, rack, role, tags and prefix.
  # ---------------------------------------------------------------------------
  # - name: idrac-ceph
  #   type: idrac
  #   username_env: IDRAC_CEPH_USER # a read-only iDRAC user is enough
  #   password_env: IDRAC_CEPH_PASS
  #   targets: inventory
  #   interface: idrac              # the interface whose address is scanned
  #   select: { tags: ["ceph"] }
  #
  # - name: idrac-lab
  #   type: idrac
  #   username_env: IDRAC_LAB_USER
  #   password_env: IDRAC_LAB_PASS
  #   verify_tls: false             # factory iDRAC certificates are self-signed
  #   targets: inventory
  #   interface: idrac
  #   select: { site: "test-lab" }
  #   concurrency: 10               # hosts scanned at once (default 5)
